@{
    ViewData["Title"] = "Home Page";
}

<section class="catalog-hero">
    <h1 class="catalog-title">EL MEJOR GRUPO 😊</h1>
    <p class="catalog-subtitle">Seleccioná la persona que desees para ver mas información de esta</p>
</section>

<section class="product-grid">
    @foreach(Integrante objIntegrante in ViewBag.grupo.devolverIntegrantes().Values)
    {
        <h3>@objIntegrante.getNombre()</h3>
            <a href="@Url.Action("InfoIntegrante","Grupo", new { dni = objIntegrante.getDni() })">Ver detalle</a><br>
    }
</section>